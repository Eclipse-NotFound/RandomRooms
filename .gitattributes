# RandomRooms —— 行尾规范
# .sh 脚本必须保持 LF（Git Bash 执行 CRLF 脚本会报 $'\r' 错误）
# .as 源码统一 LF，避免编译器/对比工具换行噪音

* text=auto
*.sh text eol=lf
*.as text eol=lf
*.md text eol=lf
*.xml text eol=lf

# Frozen runtime evidence must retain exact bytes for manifest SHA256 checks.
design/assets/v7-1-fixtures/* -text -whitespace
knowledge/experiments/fixtures-v71-evidence/* -text -whitespace
design/assets/v8-spaces/* -text -whitespace
knowledge/experiments/generator-v8-evidence/** -text -whitespace
design/assets/v9-scenes/** -text -whitespace
knowledge/experiments/generator-v9-evidence/** -text -whitespace

design/assets/v10-content/** -text -whitespace
knowledge/experiments/generator-v10-evidence/** -text -whitespace

