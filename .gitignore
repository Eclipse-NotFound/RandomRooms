# RandomRooms —— git 忽略规则
#
# 原则：源码、设计、决策、知识与状态文档全部入库；
# 可再生的构建产物与运行期文件不入库。

# 构建产物（release/*.swf 可由 build/build-m0.sh 秒级再生）
release/

# 运行期日志（applicationStorageDirectory 副本不入库）
*.log

# 操作系统/编辑器垃圾
.DS_Store
Thumbs.db
*.swp
build/__pycache__/

# 2026-09 风格原型：保留脚本，忽略可再生成样本和隔离游戏副本
build/style-review/**/__pycache__/
build/style-review/__pycache__/
build/style-review/*.png
build/style-review/*.xml
build/style-review/*.json
build/style-review/composite/
build/style-review/horizontal/
build/style-review/local/
build/style-review/harness/*.swf
build/style-review/harness/adl-*.txt
build/style-review/game-harness/app/
build/style-review/game-harness/*.swf
build/RandomRooms-v7-*.swf
build/RandomRooms-v8-*.swf
build/style-review/game-harness/visual-app/
build/release-backups/
build/style-review/*-progress.txt
build/style-review/*-error.txt

build/RandomRooms-v9-*.swf
build/RandomRooms-v10-*.swf
build/RandomRooms-v11-*.swf
build/RandomRooms-v11.*.swf
build/style-review/scene-lifecycle-before-labels-20260919/
